{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build GpioCommon Tests",

            "type": "shell",
            "command": "make",
            "args": [
                "all"
            ],

            "options": {
                "cwd": "${workspaceFolder}/Test/Dependencies/STM32F103C8T6/GPIO"
            },

            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },

        {
            "label": "Build MainComn2WifiCard Tests",

            "type": "shell",
            "command": "make",
            "args": [
                "all"
            ],

            "options": {
                "cwd": "${workspaceFolder}/Test/Protocol/MainComn2WifiCard"
            },

            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}